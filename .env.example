# Copy to .env and fill in. NEVER commit .env.
# Required
OPENAI_API_KEY=sk-your-key-here

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false   # set true once LANGCHAIN_API_KEY is filled in
LANGCHAIN_API_KEY=lsv2_your-key-here
LANGCHAIN_PROJECT=production-rag

# App (from lang-production-api)
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o-mini

# --- GLUE (not from course): retrieval settings ---
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=./chroma_db
DATA_DIR=./data/docs
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=4
HYBRID_SEARCH=false        # true = BM25 + vector (Part 2 hybrid)
AGENTIC_RETRIEVAL=false    # true = grade + rewrite loop (Part 6 agentic RAG)
MAX_REWRITES=2
MIN_RELEVANCE_SCORE=0.0    # 0 = off (vector mode only)
INGEST_API_KEY=            # if set, POST /ingest needs header X-API-Key
