# Copy to .env and fill in. NEVER commit .env.
# Required
OPENAI_API_KEY=sk-your-key-here

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false   # set true once LANGCHAIN_API_KEY is filled in
LANGCHAIN_API_KEY=lsv2_your-key-here
LANGCHAIN_PROJECT=production-rag

# App (from lang-production-api)
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o-mini

# --- GLUE (not from course): retrieval settings (defaults shown; every line is optional) ---
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=./chroma_db
DATA_DIR=./data               # /ingest and `python -m app.ingest` only read below this folder
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
EMBED_BATCH_SIZE=64           # chunks per embeddings API call
RETRIEVAL_K=5
HYBRID_SEARCH=true            # BM25 + vector (Part 2 hybrid)
HYBRID_WEIGHTS_BM25=0.4
HYBRID_WEIGHTS_VECTOR=0.6
CANDIDATES=20                 # candidates fetched from each retriever, reranked down to RETRIEVAL_K
AGENTIC_RETRIEVAL=false       # true = grade + rewrite loop (Part 6 agentic RAG)
MAX_REWRITES=2
MIN_RELEVANCE_SCORE=0.0       # vector-score refusal gate; only used when RERANKER=none (0 = off)
INGEST_API_KEY=               # if set, POST /ingest needs header X-API-Key

# --- PHASE 1 (our addition): reranker ---
RERANKER=cross-encoder        # cross-encoder (needs `uv sync --extra rerank`) | cohere | none
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # BAAI/bge-reranker-base is stronger but slower
RERANK_MIN_SCORE=0.002        # refuse when the best rerank score is lower (calibrated on the HR eval set)
COHERE_API_KEY=               # only for RERANKER=cohere
COHERE_MODEL=rerank-v3.5
